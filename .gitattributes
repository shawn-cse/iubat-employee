# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.py text eol=lf
*.svg text eol=lf
*.xml text eol=lf
*.txt text eol=lf

# Binary files
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.ico binary
